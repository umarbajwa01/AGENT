  "components": {
    "securitySchemes": {
      "cookieSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "cp_session"
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "phone", "city", "address"],
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "ConfirmOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quoteId", "nonce", "confirmed", "idempotencyKey"],
        "properties": {
          "quoteId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "nonce": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "confirmed": {
            "const": true
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address"],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "coupon": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "otp": {
            "type": "string"
          }
        }
      }
    }
  }
}

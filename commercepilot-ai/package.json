{
  "name": "commercepilot-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "local": "docker compose up -d --wait && npm run seed && npm run dev:all",
    "dev:all": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\" \"npm run worker -w server\"",
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.3.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
